# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=super-secret-key-change-in-production-blood-bank
TRUST_PROXY=false

# OPTION 1: Cloud Database Connection String (Recommended for Render + TiDB Cloud)
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=mysql://<user>:<password>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/blood_bank_demo
DB_SSL=true

# OPTION 2: Individual MySQL Parameters (For local XAMPP / MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=blood_bank_demo
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
