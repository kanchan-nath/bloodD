<%- include('../partials/header') %>

<div class="app-container">
  <%- include('../partials/sidebar') %>

  <main class="main-wrapper">
    <header class="top-header">
      <div class="page-title">
        <h2><%= isEdit ? 'Edit Donor Profile' : 'Register New Blood Donor' %></h2>
        <p><%= isEdit ? 'Update existing donor contact and demographic information' : 'Record a new volunteer donor into the MySQL donors table' %></p>
      </div>
      <div class="header-actions">
        <a href="/donors" class="btn btn-secondary btn-sm">&larr; Back to Donors</a>
      </div>
    </header>

    <div class="content-body">
      <%- include('../partials/safety_banner') %>
      <%- include('../partials/flash') %>

      <div class="card" style="max-width: 800px; margin: 0 auto;">
        <div class="card-header">
          <h3>👤 Donor Information Form</h3>
        </div>
        <div class="card-body">
          <form action="<%= isEdit ? '/donors/' + donor.donor_id + '/edit' : '/donors' %>" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="form-grid">
              <div class="form-group">
                <label for="donor_code">Donor Code *</label>
                <input 
                  type="text" 
                  id="donor_code" 
                  name="donor_code" 
                  class="form-control" 
                  value="<%= donor.donor_code || '' %>" 
                  <%= isEdit ? 'readonly style="background-color: #f1f5f9;"' : 'required' %>
                >
                <small class="form-text">Unique primary reference format (e.g. DNR-0033)</small>
              </div>

              <div class="form-group">
                <label for="full_name">Full Name *</label>
                <input 
                  type="text" 
                  id="full_name" 
                  name="full_name" 
                  class="form-control" 
                  placeholder="e.g. Ramesh Chandra" 
                  value="<%= donor.full_name || '' %>" 
                  required
                >
              </div>

              <div class="form-group">
                <label for="blood_group">Blood Group *</label>
                <select id="blood_group" name="blood_group" class="form-control" required>
                  <option value="">-- Select Blood Group --</option>
                  <% validBloodGroups.forEach(bg => { %>
                    <option value="<%= bg %>" <%= donor.blood_group === bg ? 'selected' : '' %>><%= bg %></option>
                  <% }) %>
                </select>
                <small class="form-text">Must match ENUM values defined in schema</small>
              </div>

              <div class="form-group">
                <label for="gender">Gender *</label>
                <select id="gender" name="gender" class="form-control" required>
                  <option value="">-- Select Gender --</option>
                  <% validGenders.forEach(g => { %>
                    <option value="<%= g %>" <%= donor.gender === g ? 'selected' : '' %>><%= g %></option>
                  <% }) %>
                </select>
              </div>

              <div class="form-group">
                <label for="date_of_birth">Date of Birth *</label>
                <input 
                  type="date" 
                  id="date_of_birth" 
                  name="date_of_birth" 
                  class="form-control" 
                  value="<%= donor.date_of_birth || '' %>" 
                  required
                >
              </div>

              <div class="form-group">
                <label for="city">City / Location *</label>
                <input 
                  type="text" 
                  id="city" 
                  name="city" 
                  class="form-control" 
                  placeholder="e.g. Kolkata, Durgapur, Siliguri" 
                  value="<%= donor.city || '' %>" 
                  required
                >
              </div>

              <div class="form-group">
                <label for="phone">Phone Number</label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  class="form-control" 
                  placeholder="e.g. 9876543210" 
                  value="<%= donor.phone || '' %>"
                >
              </div>

              <div class="form-group">
                <label for="email">Email Address</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  class="form-control" 
                  placeholder="e.g. donor@example.test" 
                  value="<%= donor.email || '' %>"
                >
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary">
                <%= isEdit ? '💾 Save Changes' : '➕ Register Donor' %>
              </button>
              <a href="/donors" class="btn btn-secondary">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>

<%- include('../partials/footer') %>
