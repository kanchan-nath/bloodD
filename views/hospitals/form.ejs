<%- include('../partials/header') %>

<div class="app-container">
  <%- include('../partials/sidebar') %>

  <main class="main-wrapper">
    <header class="top-header">
      <div class="page-title">
        <h2><%= isEdit ? 'Edit Partner Hospital' : 'Register New Partner Hospital' %></h2>
        <p><%= isEdit ? 'Modify hospital contact and delivery location' : 'Record an authorized medical institution into MySQL' %></p>
      </div>
      <div class="header-actions">
        <a href="/hospitals" class="btn btn-secondary btn-sm">&larr; Back to Hospitals</a>
      </div>
    </header>

    <div class="content-body">
      <%- include('../partials/safety_banner') %>
      <%- include('../partials/flash') %>

      <div class="card" style="max-width: 800px; margin: 0 auto;">
        <div class="card-header">
          <h3>🏥 Hospital Information Form</h3>
        </div>
        <div class="card-body">
          <form action="<%= isEdit ? '/hospitals/' + hospital.hospital_id + '/edit' : '/hospitals' %>" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="form-grid">
              <div class="form-group">
                <label for="hospital_code">Hospital Code *</label>
                <input 
                  type="text" 
                  id="hospital_code" 
                  name="hospital_code" 
                  class="form-control" 
                  value="<%= hospital.hospital_code || '' %>" 
                  <%= isEdit ? 'readonly style="background-color: #f1f5f9;"' : 'required' %>
                >
                <small class="form-text">Unique institution identifier (e.g. HSP-007)</small>
              </div>

              <div class="form-group">
                <label for="hospital_name">Hospital Name *</label>
                <input 
                  type="text" 
                  id="hospital_name" 
                  name="hospital_name" 
                  class="form-control" 
                  placeholder="e.g. Apollo Medical Center" 
                  value="<%= hospital.hospital_name || '' %>" 
                  required
                >
              </div>

              <div class="form-group">
                <label for="contact_person">Contact Person / Department *</label>
                <input 
                  type="text" 
                  id="contact_person" 
                  name="contact_person" 
                  class="form-control" 
                  placeholder="e.g. Dr. A. Ray (Blood Bank Officer)" 
                  value="<%= hospital.contact_person || '' %>" 
                  required
                >
              </div>

              <div class="form-group">
                <label for="city">City / Region *</label>
                <input 
                  type="text" 
                  id="city" 
                  name="city" 
                  class="form-control" 
                  placeholder="e.g. Kolkata, Durgapur" 
                  value="<%= hospital.city || '' %>" 
                  required
                >
              </div>

              <div class="form-group">
                <label for="phone">Phone Number</label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  class="form-control" 
                  placeholder="e.g. 033-24567890" 
                  value="<%= hospital.phone || '' %>"
                >
              </div>

              <div class="form-group">
                <label for="email">Official Email</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  class="form-control" 
                  placeholder="e.g. bloodbank@hospital.test" 
                  value="<%= hospital.email || '' %>"
                >
              </div>

              <div class="form-group" style="grid-column: 1 / -1;">
                <label for="address">Postal Delivery Address</label>
                <textarea 
                  id="address" 
                  name="address" 
                  class="form-control" 
                  rows="3" 
                  placeholder="e.g. 14 Medical Enclave, Sector 2, Durgapur, PIN 713206"
                ><%= hospital.address || '' %></textarea>
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary">
                <%= isEdit ? '💾 Update Hospital' : '➕ Register Hospital' %>
              </button>
              <a href="/hospitals" class="btn btn-secondary">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>

<%- include('../partials/footer') %>
